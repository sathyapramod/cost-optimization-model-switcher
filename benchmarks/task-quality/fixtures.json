    {
      "id": "analytical-10x-workload",
      "category": "other",
      "criteriaSource": "fixture_only",
      "userMessage": "Evaluate whether system X can handle 10x workload.",
      "evaluationCriteria": [
        {
          "id": "identifies_bottleneck_a",
          "description": "Identifies bottleneck A (database write path)",
          "type": "structured",
          "required": true,
          "spec": { "mustInclude": ["database", "write"] }
        },
        {
          "id": "considers_constraint_b",
          "description": "Considers constraint B (network egress cap)",
          "type": "structured",
          "required": true,
          "spec": { "mustInclude": ["egress", "network"] }
        },
        {
          "id": "performs_calculation_c",
          "description": "Performs calculation C (10x throughput vs limit)",
          "type": "structured",
          "required": true,
          "spec": { "patternsAll": ["10", "x", "req/s|requests"] }
        },
        {
          "id": "discusses_failure_mode_d",
          "description": "Discusses failure mode D (cascade under saturation)",
          "type": "structured",
          "required": true,
          "spec": { "patternsAny": ["cascade", "saturation", "queue depth"] }
        },
        {
          "id": "conclusion_with_uncertainty",
          "description": "Conclusion with uncertainty",
          "type": "structured",
          "required": true,
          "spec": { "patternsAny": ["uncertain", "cannot handle", "can handle", "risk"] }
        }
      ],
      "candidates": [
        {
          "modelId": "claude-sonnet-4-6",
          "provider": "anthropic",
          "latencyMs": 2400,
          "inputTokens": 2500,
          "outputTokens": 850,
          "output": "Assume steady 1k req/s today. At 10x (10k req/s), the database write path saturates first. Network egress cap of 2 Gbps is constraint B — calculations show ~2.4 Gbps needed. Under saturation, queue depth grows and cascade failures are likely. Conclusion: system X cannot handle 10x without sharding writes; uncertainty ±15% on traffic mix.\n"
        },
        {
          "modelId": "claude-haiku-4-5",
          "provider": "anthropic",
          "latencyMs": 900,
          "inputTokens": 2500,
          "outputTokens": 120,
          "output": "System X is fine and will easily handle 10x.\n"
        }
      ]
