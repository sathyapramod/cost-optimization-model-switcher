    {
      "id": "code-generation-plugin",
      "category": "crud_implementation",
      "userMessage": "Implement a hello endpoint with unit tests",
      "evaluationCriteria": [
        {
          "id": "compiles",
          "description": "Includes implementation code",
          "type": "deterministic",
          "required": true,
          "spec": { "check": "has_code_fence" }
        },
        {
          "id": "tests_pass",
          "description": "Includes test code",
          "type": "structured",
          "required": true,
          "spec": { "patternsAny": ["describe\\(", "it\\(", "test\\("] }
        },
        {
          "id": "requirements_satisfied",
          "description": "Hello route present",
          "type": "structured",
          "required": true,
          "spec": { "mustInclude": ["hello", "200"] }
        }
      ],
      "candidates": [
        {
          "modelId": "claude-sonnet-4-6",
          "provider": "anthropic",
          "latencyMs": 2100,
          "inputTokens": 4000,
          "outputTokens": 900,
          "output": "```ts\nexport function hello() { return { status: 200, body: 'hello' }; }\n```\n```ts\ndescribe('hello', () => { it('returns 200', () => expect(hello().status).toBe(200)); });\n```\n"
        }
      ]
    },
    {
      "id": "code-review-sql",
      "category": "pr_review",
      "userMessage": "Review PR diff and list security bugs",
      "probes": [{ "source": "github_pr", "additions": 200, "deletions": 10, "changedFiles": 3 }],
      "evaluationCriteria": [
        {
          "id": "identify_known_defects",
          "description": "Flags SQL injection",
          "type": "structured",
          "required": true,
          "spec": { "patternsAny": ["sql injection", "parameteriz"] }
        },
        {
          "id": "avoid_false_positives",
          "description": "Does not invent unrelated CVE",
          "type": "structured",
          "required": true,
          "spec": { "mustNotInclude": ["CVE-2099-9999"] }
        },
        {
          "id": "classify_severity",
          "description": "Uses severity label",
          "type": "structured",
          "required": true,
          "spec": { "patternsAny": ["high", "critical"] }
        }
      ],
      "candidates": [
        {
          "modelId": "claude-sonnet-4-6",
          "provider": "anthropic",
          "latencyMs": 1500,
          "inputTokens": 8000,
          "outputTokens": 420,
          "output": "**High**: User input concatenated into SQL in `UserRepo.lookup` — use parameterized queries to prevent SQL injection.\n"
        }
      ]
    },
    {
      "id": "debugging-race",
      "category": "debugging",
      "userMessage": "Fix the race condition in the cache module",
      "evaluationCriteria": [
        {
          "id": "identify_root_cause",
          "description": "Names race on shared map",
          "type": "structured",
          "required": true,
          "spec": { "mustInclude": ["race", "concurrent"] }
        },
        {
          "id": "provide_evidence",
          "description": "Cites log or stack evidence",
          "type": "rubric",
          "required": true,
          "spec": { "rubricKeywords": ["log", "stack", "interleaved", "goroutine", "thread"] }
        },
        {
          "id": "fix_addresses_root_cause",
          "description": "Proposes mutex or serialization",
          "type": "structured",
          "required": true,
          "spec": { "patternsAny": ["mutex", "lock", "serializ"] }
        }
      ],
      "candidates": [
        {
          "modelId": "claude-sonnet-4-6",
          "provider": "anthropic",
          "latencyMs": 1800,
          "inputTokens": 6000,
          "outputTokens": 500,
          "output": "Root cause: concurrent goroutines write the shared map without synchronization (race). Log lines and stack trace show interleaved PUT on multiple threads. Fix: guard cache with a mutex.\n"
        }
      ]
    },
    {
      "id": "architecture-auth-migration",
      "category": "architecture",
      "userMessage": "Design auth migration from legacy sessions to JWT",
