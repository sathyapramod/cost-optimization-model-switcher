        {
          "id": "address_failure_modes",
          "description": "Mentions rollback or token revocation failure",
          "type": "structured",
          "required": true,
          "spec": { "patternsAny": ["rollback", "revocation", "failure mode"] }
        }
      ],
      "candidates": [
        {
          "modelId": "claude-opus-4-6",
          "provider": "anthropic",
          "latencyMs": 3200,
          "inputTokens": 3000,
